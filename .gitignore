# ==============================================================================
# DATA DIRS
# ==============================================================================
# Ignore all data except for .gitkeep markers
services/credit-risk-ml/data/*
!/data/.gitkeep

# Ignore all model files except for .gitkeep markers

services/credit-risk-ml/models/**
!/models/.gitkeep

# Ignore checkpoints do Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Ignore notebooks and experiment history (keep .gitkeep)
/services/credit-risk-ml/notebooks
/services/credit-risk-ml/notebooks/.gitkeep

# ==============================================================================
# PYTHON (Service: credit-risk-ml)
# ==============================================================================
# Bytecode
__pycache__/
*.py[cod]
*$py.class

# Ambientes Virtuais
.venv/
venv/
env/

# Distribuição e Build
build/
dist/
*.egg-info/
.eggs/

# Testes e Cobertura
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Tipagem Estática e Linting
.mypy_cache/
.ruff_cache/

